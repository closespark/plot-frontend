# Plot frontend env
# Copy to .env.local for local dev

# Backend API (the FastAPI server we built in api/)
PLOT_API_BASE=http://localhost:8000
PLOT_API_KEY=pl_set_a_real_key_here

# Public R2/CDN base for pre-rendered NAIP marketing tiles
# (whatever you serve naip-marketing/ from — R2 public bucket or Cloudflare)
NEXT_PUBLIC_NAIP_BASE=https://cdn.get-plot.com
