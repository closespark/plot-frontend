# Plot frontend env
# Copy to .env.local for local dev

# Backend API (the FastAPI server we built in api/)
PLOT_API_BASE=http://localhost:8000
PLOT_API_KEY=pl_set_a_real_key_here

# Public R2/CDN base for pre-rendered Mapbox marketing tiles
# (whatever you serve mapbox-marketing/ from — R2 public bucket or Cloudflare).
# Source images are Mapbox satellite-v9 z=20 with the attribution strip
# cropped off; attribution is restored as a credit line in the site footer
# for Mapbox/OSM ToS compliance.
NEXT_PUBLIC_MAPBOX_BASE=https://cdn.get-plot.com
